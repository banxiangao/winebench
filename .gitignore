# Rebuildable or too large for a git host
venv-vllm/
container/*.sif
*.tgz
*.tar.gz

# Pilot (Wine 11.18, wine500_doc): 4.1 GB of runs and logs, kept on Vulcan only
archive/

# Generated by the jobs; added once the formal runs have finished
wine_bench/runs/
wine_agent/runs/

# Never commit real keys (the .example file is kept)
secrets.toml
.env
.env.*

__pycache__/
*.pyc
.claude/

# Job logs: carry node names, user and project paths; kept on Vulcan only
logs/
container/*.out
container/build.log

# Leakage experiment: downloaded documentation pages and the candidate records before pairing (rebuilt by
# leakage/fetch_docs.sh and leakage/prepare_*.sbatch); the two final datasets are in wine_agent/dataset/leak2024_*
leakage/msdocs/
leakage/candidates/*/dataset/
leakage/candidates/*/baseline/
