   "signature": "static void reset_heap( struct heap *heap )",
   "code": "static void reset_heap( struct heap *heap )\n{\n    if (heap->handle) HeapDestroy( heap->handle );\n    heap->handle   = NULL;\n    heap->max_size = heap->allocated = 0;\n}"
