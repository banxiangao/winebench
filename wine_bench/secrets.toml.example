# API keys.  Fill in the ones you have; leave the others as "".
# This file is listed in .gitignore - never commit it.
# (The same names also work as environment variables; a value here takes priority.)

[keys]
ARK_API_KEY       = ""   # 豆包 / 火山方舟
DEEPSEEK_API_KEY  = ""   # DeepSeek
OPENAI_API_KEY    = ""   # ChatGPT / OpenAI
ANTHROPIC_API_KEY = ""   # Claude
DASHSCOPE_API_KEY = ""   # Qwen / 通义千问
XAI_API_KEY       = ""   # Grok
GEMINI_API_KEY    = ""   # Gemini
MOONSHOT_API_KEY  = ""   # Kimi
ZHIPU_API_KEY     = ""   # GLM / 智谱
LOCAL_API_KEY     = ""   # any value for a local server, e.g. "none"
