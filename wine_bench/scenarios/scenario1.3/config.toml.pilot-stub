# Scenario 1.3 - evaluation-only stub (written on the Ubuntu evaluation machine: the real config.toml of this
# scenario lives on the Mac; copy it over this file whenever you like - evaluate.py only needs [paths] and
# [stage.programmer] without input_stage).  Programmer replies: runs/scenario1.3/programmer/responses/<model>/<id>.c

[paths]                               # relative to this file
dataset = "../../dataset/wine500_doc"
out     = "../../runs/scenario1.3"
models  = "../models.toml"
secrets = "../../secrets.toml"

[run]
workers       = 32
max_retries   = 3
timeout_s     = 900
temperature   = 0.0
max_tokens    = 0
skip_existing = true

[stage.programmer]
reply_format = "code"
